---
import { Icon } from "astro-icon/components";
import Footer from "../components/Footer.astro";
import Projects from "../components/Projects.astro";
import Section from "../components/Section.astro";
import { interests, person } from "../data/content";
import BaseLayout from "../layouts/BaseLayout.astro";

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    mainEntity: {
        "@type": "Person",
        name: person.name,
        url: "https://adrianjust.com/",
        jobTitle: "Computer Science Student & Systems Software Developer",
        description: person.intro,
        knowsAbout: interests,
        sameAs: person.links.map((l) => l.href),
    },
};
---

<BaseLayout>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <main id="top">
        <section
            aria-labelledby="intro-heading"
            class="pt-16 pb-14 sm:pt-24 sm:pb-16"
        >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
                <h1
                    id="intro-heading"
                    class="font-serif text-4xl sm:text-5xl tracking-tight"
                >
                    {person.name}
                </h1>

                <div class="flex items-center gap-4 text-muted">
                    {person.links.map(({ label, href, icon }) => (
                        <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={label}
                            class="transition-colors hover:text-accent"
                        >
                            <Icon name={icon} class="w-5 h-5" />
                        </a>
                    ))}
                </div>
            </div>

            <p class="mt-5 max-w-prose text-lg leading-relaxed text-muted">
                {person.intro}
            </p>

            <div class="mt-8 space-y-4">
                {person.paragraphs.map((p) => (
                    <p class="max-w-prose text-sm leading-7">{p}</p>
                ))}
            </div>

            <dl class="mt-10 space-y-1.5 font-mono text-[0.75rem]">
                {person.metadata.map(([k, v]) => (
                    <div class="flex flex-col gap-x-4 sm:flex-row">
                        <dt class="text-faint sm:w-36 sm:shrink-0">{k}</dt>
                        <dd class="text-muted">{v}</dd>
                    </div>
                ))}
            </dl>
        </section>

        <Section id="projects" label="Open source projects">
            <Projects />
        </Section>

        <Section id="interests" label="Areas of interest">
            <ul class="grid grid-cols-1 gap-x-8 gap-y-2 font-mono text-[0.85rem] sm:grid-cols-2">
                {interests.map((i) => (
                    <li class="text-muted flex items-center gap-2">
                        <Icon
                            name="lucide:corner-down-right"
                            class="w-3.5 h-3.5 shrink-0 text-faint"
                            aria-hidden="true"
                        />
                        <span>{i}</span>
                    </li>
                ))}
            </ul>
        </Section>
    </main>
    <Footer />
</BaseLayout>
