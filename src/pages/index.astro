---
import { Icon } from "astro-icon/components";
import Projects from "../components/Projects.astro";
import Section from "../components/Section.astro";
import { interests, person } from "../data/content";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Adrian Just">
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "ProfilePage",
            "mainEntity": {
                "@type": "Person",
                "name": "Adrian Just",
                "url": "https://adrianjust.com/",
                "sameAs": [
                    "https://github.com/iadyo",
                    "https://linkedin.com/in/adrianjust"
                ]
            }
        }
    </script>
    <main id="top">
        <section
            aria-labelledby="intro-heading"
            class="pt-16 pb-14 sm:pt-24 sm:pb-16"
        >
            <div class="flex gap-6">
                <h1
                    id="intro-heading"
                    class="font-serif text-5xl tracking-tight"
                >
                    {person.name}
                </h1>

                <div class="flex items-center space-x-4">
                    {person.links.map(({ label, href, icon }) => (
                        <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={label}
                        >
                            <Icon
                                name={icon}
                                class="w-6 h-6 hover:text-white transition-colors"
                            />
                        </a>
                    ))}
                </div>
            </div>

            <p class="mt-5 max-w-prose text-lg leading-relaxed text-muted">
                {person.intro}
            </p>

            <div class="mt-8 space-y-4">
                {person.paragraphs.map((p) => (
                    <p class="max-w-prose text-sm leading-7">{p}</p>
                ))}
            </div>

            <dl class="mt-10 space-y-1.5 font-mono text-base text-[0.75rem]">
                {person.metadata.map(([k, v]) => (
                    <div class="flex flex-col gap-x-4 sm:flex-row">
                        <dt class="text-faint sm:w-36 sm:shrink-0">{k}</dt>
                        <dd class="text-muted">{v}</dd>
                    </div>
                ))}
            </dl>
        </section>

        <Section id="projects" label="Open source projects">
            <Projects />
        </Section>

        <Section id="interests" label="Areas of interest">
            <ul class="columns-2 gap-x-10 font-mono text-[0.85rem] sm:columns-3">
                {interests.map((i) => (
                    <li class="break-inside-avoid py-1 text-muted">{i}</li>
                ))}
            </ul>
        </Section>
    </main>
</BaseLayout>
