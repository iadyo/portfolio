---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Adrian Just" description="Page not found">
    <div class="flex min-h-[65vh] flex-col items-start justify-center py-16">
        <span class="font-mono text-xs tracking-widest text-faint uppercase">
            [error 404]
        </span>

        <h1 class="mt-3 font-serif text-3xl sm:text-4xl text-fg">
            Page not found
        </h1>

        <p class="mt-3 max-w-prose text-[0.95rem] leading-relaxed text-muted">
            The requested document doesn't exist, was moved, or never made it
            out of staging.
        </p>

        <div class="mt-8">
            <a
                href="/"
                class="group inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-fg"
            >
                <Icon
                    name="lucide:arrow-left"
                    class="h-3.5 w-3.5 transition-transform duration-200 group-hover:-translate-x-0.5"
                />
                <span>back to index</span>
            </a>
        </div>
    </div>
</BaseLayout>
