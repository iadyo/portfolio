---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Adrian Just: Page Not Found">
    <div class="flex min-h-screen items-center justify-center bg-bg px-4">
        <div class="max-w-md text-center">
            <h1 class="text-7xl font-bold text-fg">404</h1>

            <h2 class="mt-4 text-xl font-semibold text-fg">Page not found</h2>

            <p class="mt-2 text-sm text-muted">
                The page you're looking for doesn't exist or has been moved.
            </p>

            <div class="mt-6">
                <a
                    href="/"
                    class="inline-flex items-center justify-center rounded-md bg-fg px-4 py-2 text-sm font-medium text-bg transition-colors hover:bg-fg/90"
                >
                    Go home
                </a>
            </div>
        </div>
    </div>
</BaseLayout>
