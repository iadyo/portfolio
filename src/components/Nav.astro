---
import { person } from "../data/content";
---

<header class="pt-8 sm:pt-10">
    <nav
        aria-label="Primary"
        class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4"
    >
        <a href="/" class="font-mono text-sm">
            {person.name}
        </a>

        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-sm text-muted">
            <li>
                <a
                    href="/"
                    class="hover:text-accent duration-300 transition-colors"
                >
                    Home
                </a>
            </li>
            <li>
                <a
                    href="/#projects"
                    class="hover:text-accent duration-300 transition-colors"
                >
                    Projects
                </a>
            </li>
            <li>
                <a
                    href="/notes"
                    class="hover:text-accent duration-300 transition-colors"
                >
                    Notes
                </a>
            </li>
        </ul>
    </nav>
</header>
