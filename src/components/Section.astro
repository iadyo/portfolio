---
type Props = {
    id: string;
    label: string;
};

const { id, label } = Astro.props;
---

<section
    id={id}
    aria-labelledby={`${id}-heading`}
    class="rule-top py-14 sm:py-16"
>
    <h2
        id={`${id}-heading`}
        class="font-mono uppercase text-faint text-[0.6875rem] tracking-wider mb-8"
    >
        {label}
    </h2>
    <slot />
</section>
